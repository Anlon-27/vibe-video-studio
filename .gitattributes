# 自动归一化文本行尾为 LF，防止 Windows / Linux 之间产生 CRLF 脏改动
* text=auto eol=lf

# 脚本与可执行文件
*.py text eol=lf
*.sh text eol=lf
*.bat text eol=crlf
*.js text eol=lf
*.html text eol=lf
*.css text eol=lf
*.json text eol=lf
*.md text eol=lf

# 二进制文件不转换
*.png binary
*.jpg binary
*.jpeg binary
*.mp3 binary
*.wav binary
*.mp4 binary
